#!/usr/bin/env bash
#MISE description="Launch a command in a persistent named shell"
#USAGE arg "<name>" help="Session name (alphanumeric, hyphens, underscores)"
#USAGE flag "--cwd <cwd>" help="Working directory for the command"
#USAGE arg "<command>" help="Command to run" var=#true
set -euo pipefail

NAME="${usage_name:-}"
CWD="${usage_cwd:-}"

# --- Parse variadic command args (mise passes them as a shell-escaped string) ---

COMMAND=()
if [ -n "${usage_command:-}" ]; then
  while IFS= read -r arg; do
    COMMAND+=("$arg")
  done < <(printf '%s' "${usage_command}" | xargs printf '%s\n')
fi

# --- Validation ---

if [ -z "$NAME" ]; then
  echo "Error: session name required" >&2
  echo "Usage: shell run <name> <command...>" >&2
  exit 1
fi

if [[ "$NAME" == -* ]]; then
  echo "Error: session name cannot start with a dash: '$NAME'" >&2
  echo "  (zmx treats this as the session name, not a flag)" >&2
  exit 1
fi

if ! [[ "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Error: invalid session name '$NAME'" >&2
  echo "  Names must start with alphanumeric, then alphanumeric, hyphens, underscores, or dots" >&2
  exit 1
fi

if [ ${#COMMAND[@]} -eq 0 ]; then
  echo "Error: command required" >&2
  echo "Usage: shell run <name> <command...>" >&2
  exit 1
fi

# --- Dependency check ---

if ! command -v zmx >/dev/null 2>&1; then
  echo "Error: zmx is required but not installed" >&2
  echo "  Install: https://zmx.sh" >&2
  exit 1
fi

# --- Check for existing session ---

source "$MISE_CONFIG_ROOT/lib/session-state.sh"

SESSION_JSON=$(zmx list --json 2>/dev/null | jq -c --arg name "$NAME" 'first(.[] | select(.name == $name)) // empty')
if [ -n "$SESSION_JSON" ]; then
  NORMALIZED_JSON=$(shell_normalize_session_json "$SESSION_JSON")
  SESSION_STATUS=$(printf '%s' "$NORMALIZED_JSON" | jq -r '.status')

  if [ "$SESSION_STATUS" != "idle" ]; then
    echo "Error: session '$NAME' is not safely idle (status: $SESSION_STATUS)" >&2
    echo "  Use 'shell status --json $NAME' to inspect PTY, foreground, and last-task state" >&2
    echo "  Use 'shell send $NAME <input>' for a known live process or 'shell kill $NAME' to stop it" >&2
    exit 1
  fi
fi

# --- Launch ---
# zmx run -d only acknowledges that the daemon queued the PTY input. Shell's
# contract is slightly stronger: return after the session shell has begun
# executing the command, but before the command completes. Prefix the submitted
# shell line with a marker-file write, then wait for that marker to appear.

shell_quote() {
  case "$1" in
    "")
      printf "''"
    ;;
    *[!a-zA-Z0-9_./:=+,-]*)
      local value="$1"
      value=${value//\'/\'\\\'\'}
      printf "'%s'" "$value"
    ;;
    *)
      printf '%s' "$1"
    ;;
  esac
}

build_run_line() {
  local marker_file="$1"
  shift

  if [ -n "$CWD" ]; then
    printf '( cd %s && { ' "$(shell_quote "$CWD")"
  fi

  printf ': > %s; ' "$(shell_quote "$marker_file")"

  local first=true
  local arg
  for arg in "$@"; do
    if $first; then
      first=false
    else
      printf ' '
    fi
    shell_quote "$arg"
  done

  if [ -n "$CWD" ]; then
    printf '; } )'
  fi
}

wait_for_launch_marker() {
  local marker_file="$1"
  local i

  for i in $(seq 1 100); do
    if [ -f "$marker_file" ]; then
      return 0
    fi
    sleep 0.1
  done

  echo "Error: session '$NAME' did not confirm command launch" >&2
  echo "  zmx accepted the command, but the launch marker was not observed" >&2
  return 1
}

if [ -n "$CWD" ] && [ ! -d "$CWD" ]; then
  echo "Error: --cwd directory not found: $CWD" >&2
  exit 1
fi

TMP_BASE="${TMPDIR:-/tmp}"
TMP_BASE="${TMP_BASE%/}"
MARKER_FILE=$(mktemp "$TMP_BASE/shell-run-started.XXXXXX")
rm -f "$MARKER_FILE"
RUN_LINE=$(build_run_line "$MARKER_FILE" "${COMMAND[@]}")

cleanup_marker() {
  rm -f "$MARKER_FILE"
}
trap cleanup_marker EXIT

# Suppress zmx's "session created" / "command sent" output.
# The session name is printed by this task on success.
zmx run "$NAME" -d eval "$RUN_LINE" </dev/null >/dev/null 2>&1
wait_for_launch_marker "$MARKER_FILE"
echo "$NAME"
