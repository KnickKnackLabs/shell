#!/usr/bin/env bash
#MISE description="Launch a command in a persistent named shell"
#USAGE arg "<name>" help="Session name (alphanumeric, hyphens, underscores)"
#USAGE flag "--cwd <cwd>" help="Working directory for the command"
#USAGE flag "--probe-ready" default=#false help="Require the session shell to execute a harmless probe before submitting the command"
#USAGE flag "--ready-timeout <seconds>" help="Probe deadline in seconds, 1-300 (default: 10; requires --probe-ready)"
#USAGE arg "<command>" help="Command to run" var=#true
#USAGE example "shell run --probe-ready --ready-timeout 10 --cwd /path/to/home desk-name /path/to/launcher" header="Wait for shell execution before a desk wake"
set -euo pipefail

NAME="${usage_name:-}"
CWD="${usage_cwd:-}"
PROBE_READY="${usage_probe_ready:-false}"
READY_TIMEOUT="${usage_ready_timeout:-10}"
ZMX_BIN="${ZMX_BIN:-zmx}"

# --- Parse variadic command args (mise passes them as a shell-escaped string) ---

COMMAND=()
if [ -n "${usage_command:-}" ]; then
  while IFS= read -r arg; do
    COMMAND+=("$arg")
  done < <(printf '%s' "${usage_command}" | xargs printf '%s\n')
fi

# --- Validation ---

if [ -z "$NAME" ]; then
  echo "Error: session name required" >&2
  echo "Usage: shell run <name> <command...>" >&2
  exit 1
fi

if [[ "$NAME" == -* ]]; then
  echo "Error: session name cannot start with a dash: '$NAME'" >&2
  echo "  (zmx treats this as the session name, not a flag)" >&2
  exit 1
fi

if ! [[ "$NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Error: invalid session name '$NAME'" >&2
  echo "  Names must start with alphanumeric, then alphanumeric, hyphens, underscores, or dots" >&2
  exit 1
fi

if [ ${#COMMAND[@]} -eq 0 ]; then
  echo "Error: command required" >&2
  echo "Usage: shell run <name> <command...>" >&2
  exit 1
fi
if ! [[ "$READY_TIMEOUT" =~ ^[1-9][0-9]{0,2}$ ]] || [ "$READY_TIMEOUT" -gt 300 ]; then
  echo "Error: --ready-timeout must be an integer from 1 to 300" >&2
  exit 1
fi
if [ -n "${usage_ready_timeout:-}" ] && [ "$PROBE_READY" != true ]; then
  echo "Error: --ready-timeout requires --probe-ready" >&2
  exit 1
fi

# --- Dependency check ---

if ! command -v "$ZMX_BIN" >/dev/null 2>&1; then
  echo "Error: zmx is required but not installed" >&2
  echo "  Install: https://zmx.sh" >&2
  exit 1
fi

# --- Check for existing session ---

SESSION_STATUS=$("$ZMX_BIN" list --json 2>/dev/null | jq -r --arg name "$NAME" 'first(.[] | select(.name == $name) | .status) // empty')
if [ -n "$SESSION_STATUS" ]; then
  case "$SESSION_STATUS" in
    exited*)
      # Idle (previous command finished, shell at prompt) — allow reuse.
      :
    ;;
    *)
      # Busy (command still running)
      echo "Error: session '$NAME' is busy (command still running)" >&2
      echo "  Use 'shell send $NAME <input>' to send input to the running process" >&2
      echo "  Or 'shell kill $NAME' to stop it" >&2
      exit 1
    ;;
  esac
fi

# --- Launch ---
# zmx run -d only acknowledges that the daemon queued the PTY input. Shell's
# contract is slightly stronger: return after the session shell has begun
# executing the command, but before the command completes. Prefix the submitted
# shell line with a marker-file write, then wait for that marker to appear.

shell_quote() {
  case "$1" in
    "")
      printf "''"
    ;;
    *[!a-zA-Z0-9_./:=+,-]*)
      local value="$1"
      value=${value//\'/\'\\\'\'}
      printf "'%s'" "$value"
    ;;
    *)
      printf '%s' "$1"
    ;;
  esac
}

build_run_line() {
  local marker_file="$1"
  shift

  if [ -n "$CWD" ]; then
    printf '( cd %s && { ' "$(shell_quote "$CWD")"
  fi

  printf ': > %s; ' "$(shell_quote "$marker_file")"

  local first=true
  local arg
  for arg in "$@"; do
    if $first; then
      first=false
    else
      printf ' '
    fi
    shell_quote "$arg"
  done

  if [ -n "$CWD" ]; then
    printf '; } )'
  fi
}

wait_for_launch_marker() {
  local marker_file="$1"
  local i

  for i in $(seq 1 100); do
    if [ -f "$marker_file" ]; then
      return 0
    fi
    sleep 0.1
  done

  echo "Error: session '$NAME' did not confirm command launch" >&2
  echo "  zmx accepted the command, but the launch marker was not observed" >&2
  return 1
}

probe_shell_readiness() {
  local marker_file="$1" deadline=$((SECONDS + READY_TIMEOUT))
  local poll

  # An acknowledged zmx run can be read by a login-time terminal program.
  # Only this file effect proves that the session shell executed a probe.
  while [ "$SECONDS" -lt "$deadline" ]; do
    [ ! -f "$marker_file" ] || return 0
    "$ZMX_BIN" run "$NAME" -d eval ": > $(shell_quote "$marker_file")" </dev/null >/dev/null 2>&1
    for poll in 1 2 3 4 5; do
      [ ! -f "$marker_file" ] || return 0
      [ "$SECONDS" -lt "$deadline" ] || break
      sleep 0.1
    done
  done
  [ ! -f "$marker_file" ] || return 0
  echo "Error: session '$NAME' did not execute a readiness probe within ${READY_TIMEOUT}s" >&2
  return 1
}

if [ -n "$CWD" ] && [ ! -d "$CWD" ]; then
  echo "Error: --cwd directory not found: $CWD" >&2
  exit 1
fi

TMP_BASE="${TMPDIR:-/tmp}"
TMP_BASE="${TMP_BASE%/}"
MARKER_FILE=$(mktemp "$TMP_BASE/shell-run-started.XXXXXX")
rm -f "$MARKER_FILE"
RUN_LINE=$(build_run_line "$MARKER_FILE" "${COMMAND[@]}")
PROBE_DIR=

cleanup_marker() {
  rm -f "$MARKER_FILE"
  [ -z "$PROBE_DIR" ] || rm -rf -- "$PROBE_DIR"
}
trap cleanup_marker EXIT

if [ "$PROBE_READY" = true ]; then
  PROBE_DIR=$(mktemp -d "$TMP_BASE/shell-run-probe.XXXXXX")
  probe_shell_readiness "$PROBE_DIR/executed"
fi

# Suppress zmx's "session created" / "command sent" output.
# The session name is printed by this task on success.
"$ZMX_BIN" run "$NAME" -d eval "$RUN_LINE" </dev/null >/dev/null 2>&1
wait_for_launch_marker "$MARKER_FILE"
echo "$NAME"
