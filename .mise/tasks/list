#!/usr/bin/env bash
#MISE description="List active shells"
#USAGE flag "--json" help="Output as JSON"
set -euo pipefail

if ! command -v zmx >/dev/null 2>&1; then
  echo "Error: zmx is required but not installed" >&2
  exit 1
fi

JSON="${usage_json:-false}"

source "$MISE_CONFIG_ROOT/lib/session-state.sh"

SESSIONS_JSON=$(zmx list --json 2>/dev/null)
NORMALIZED=()
while IFS= read -r session_json; do
  [ -z "$session_json" ] && continue
  NORMALIZED+=("$(shell_normalize_session_json "$session_json")")
done < <(printf '%s\n' "$SESSIONS_JSON" | jq -c '.[]')

if [ "$JSON" = "true" ]; then
  printf '%s\n' ${NORMALIZED[@]+"${NORMALIZED[@]}"} | jq -sc '.'
elif [ ${#NORMALIZED[@]} -eq 0 ]; then
  echo "No active shells."
else
  for session_json in "${NORMALIZED[@]}"; do
    name=$(printf '%s' "$session_json" | jq -r '.name')
    cmd=$(printf '%s' "$session_json" | jq -r '.cmd')
    summary=$(shell_status_summary "$session_json")
    printf "%-30s %-55s %s\n" "$name" "$summary" "$cmd"
  done
fi
